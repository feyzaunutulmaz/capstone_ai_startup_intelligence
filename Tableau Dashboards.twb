      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0lfi4kr1tc2xtb173mksv138q1fu].[avg:company_age_at_last_funding:qk]&quot;' value='Avg. Age (yrs)' />
          <alias key='&quot;[federated.0lfi4kr1tc2xtb173mksv138q1fu].[avg:funding_rounds:qk]&quot;' value='Avg. Rounds' />
          <alias key='&quot;[federated.0lfi4kr1tc2xtb173mksv138q1fu].[avg:n_categories:qk]&quot;' value='Avg. Categories' />
