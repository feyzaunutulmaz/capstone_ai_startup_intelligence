    <worksheet name='D3_Trichter'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Where Startups Stop: Furthest Funding Round Reached</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Crunchbase Startups' name='federated.0lfi4kr1tc2xtb173mksv138q1fu' />
          </datasources>
          <datasource-dependencies datasource='federated.0lfi4kr1tc2xtb173mksv138q1fu'>
            <column caption='Funnel Start' datatype='real' name='[Calculation_1787029900668935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-COUNTD([company]) / 2' />
            </column>
            <column caption='Company' datatype='string' name='[company]' role='dimension' type='nominal' />
            <column-instance column='[company]' derivation='CountD' name='[ctd:company:qk]' pivot='key' type='quantitative' />
            <column caption='Furthest Round Reached' datatype='string' name='[furthest_round_reached]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;A&quot;' value='Series A' />
                <alias key='&quot;B&quot;' value='Series B' />
                <alias key='&quot;C&quot;' value='Series C' />
                <alias key='&quot;D&quot;' value='Series D' />
                <alias key='&quot;E&quot;' value='Series E' />
