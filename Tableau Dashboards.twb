              <groupfilter function='level-members' level='[none:furthest_round_reached:nk]' />
              <groupfilter function='member' level='[none:furthest_round_reached:nk]' member='&quot;Other/Unknown&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0lfi4kr1tc2xtb173mksv138q1fu].[none:furthest_round_reached:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Seed/Angel only&quot;</bucket>
