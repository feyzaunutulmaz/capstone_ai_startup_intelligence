      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1eikjpp0qwyg8n17u3g1p1nbg5kr].[__tableau_internal_object_id__].[cnt:Sheet1_9113FA16256A4E6783C6969CFE3C07C6:qk]&quot;' value='Number of Deals 2014-2025' />
        </aliases>
      </column>
      <column caption='Funding (Billion $)' datatype='real' default-format='c#,##0,,,.00B&quot;$&quot;;-#,##0,,,.00B&quot;$&quot;' name='[Calculation_1787029570428929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([funding_total_usd]) / 1000000000' />
      </column>
      <column caption='Startups' datatype='integer' name='[Calculation_1787029572050946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([company])' />
      </column>
      <column caption='Größter Deal (B $)' datatype='real' default-format='c#,##0,,,.00B&quot;$&quot;;-#,##0,,,.00B&quot;$&quot;' name='[Calculation_1787029579366403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([funding_total_usd])' />
      </column>
      <column caption='High-Value Round' datatype='boolean' name='[Calculation_1787029579476996]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[deal_size_tier] = &quot;Unicorn ($1B+)&quot; OR [deal_size_tier] = &quot;Mega ($10B+)&quot;' />
      </column>
      <column caption='LLM Valuation Share' datatype='real' default-format='p0%' name='[Calculation_1787030186541064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [sector] = &quot;Foundation Model / LLM&quot; THEN [pre_money_valuation_millions] END)&#13;&#10;   / SUM([pre_money_valuation_millions])' />
      </column>
      <column caption='Valuation (B$)' datatype='real' name='[Calculation_1787030189977609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[post_money_valuation_millions] / 1000' />
      </column>
      <column caption='Deals 2014-2025' datatype='table' name='[__tableau_internal_object_id__].[Sheet1_9113FA16256A4E6783C6969CFE3C07C6]' role='measure' type='quantitative' />
