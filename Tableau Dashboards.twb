      <column caption='Funding (Mio $)' datatype='real' default-format='c#,##0,,.00M&quot;$&quot;;-#,##0,,.00M&quot;$&quot;' name='[Calculation_1787029570277376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([funding_total_usd]) / 1000000' />
      </column>
      <column caption='Funding Group' datatype='string' name='[Calculation_1787029579657221]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [highly_funded] THEN &quot;Top 25 % finanziert&quot; ELSE &quot;Übrige 75 %&quot; END' />
        <aliases>
          <alias key='&quot;Top 25 \% finanziert&quot;' value='Top 25 %' />
          <alias key='&quot;Übrige 75 \%&quot;' value='Other 75 %' />
        </aliases>
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1787029579722758]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [company_age_at_last_funding] &lt;= 1.93 THEN &quot;Jung (≤ 1,9 J.)&quot; ELSE &quot;Älter (&gt; 1,9 J.)&quot; END' />
        <aliases>
          <alias key='&quot;Jung (≤ 1,9 J.)&quot;' value='Younger' />
          <alias key='&quot;Älter (&gt; 1,9 J.)&quot;' value='Older' />
        </aliases>
      </column>
      <column caption='Funnel Start' datatype='real' name='[Calculation_1787029900668935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-COUNTD([company]) / 2' />
      </column>
