    <worksheet name='D4_Boxplot_Alter'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>Funding by Age</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Distribution per age group (log scale)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Crunchbase Startups' name='federated.0lfi4kr1tc2xtb173mksv138q1fu' />
          </datasources>
          <datasource-dependencies datasource='federated.0lfi4kr1tc2xtb173mksv138q1fu'>
            <column caption='Funding Group' datatype='string' name='[Calculation_1787029579657221]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [highly_funded] THEN &quot;Top 25 % finanziert&quot; ELSE &quot;Übrige 75 %&quot; END' />
              <aliases>
                <alias key='&quot;Top 25 \% finanziert&quot;' value='Top 25 %' />
                <alias key='&quot;Übrige 75 \%&quot;' value='Other 75 %' />
              </aliases>
            </column>
            <column caption='Age Group' datatype='string' name='[Calculation_1787029579722758]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [company_age_at_last_funding] &lt;= 1.93 THEN &quot;Jung (≤ 1,9 J.)&quot; ELSE &quot;Älter (&gt; 1,9 J.)&quot; END' />
              <aliases>
                <alias key='&quot;Jung (≤ 1,9 J.)&quot;' value='Younger' />
                <alias key='&quot;Älter (&gt; 1,9 J.)&quot;' value='Older' />
              </aliases>
            </column>
            <column caption='Avg Funding Per Round' datatype='real' name='[avg_funding_per_round]' role='measure' type='quantitative' />
            <column caption='Company' datatype='string' name='[company]' role='dimension' type='nominal' />
            <column caption='Company Age At Last Funding' datatype='real' name='[company_age_at_last_funding]' role='measure' type='quantitative' />
            <column caption='Highly Funded' datatype='boolean' name='[highly_funded]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1787029579657221]' derivation='None' name='[none:Calculation_1787029579657221:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1787029579722758]' derivation='None' name='[none:Calculation_1787029579722758:nk]' pivot='key' type='nominal' />
            <column-instance column='[company]' derivation='None' name='[none:company:nk]' pivot='key' type='nominal' />
            <column-instance column='[avg_funding_per_round]' derivation='Sum' name='[sum:avg_funding_per_round:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0lfi4kr1tc2xtb173mksv138q1fu].[sum:avg_funding_per_round:qk]' included-values='non-null' />
          <slices>
            <column>[federated.0lfi4kr1tc2xtb173mksv138q1fu].[sum:avg_funding_per_round:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
